
ARG VLLM_BASE_IMAGE=vllm/vllm-openai:v0.33.0

FROM ${VLLM_BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/maxdswain/vllm-gliner"
LABEL org.opencontainers.image.title="Hardened vLLM GLiNER"
LABEL org.opencontainers.image.version="0.5"
LABEL org.opencontainers.image.description="GLiNER2.5 serving on vLLM with Ubuntu security updates and Python dependency hardening"

USER root

# ============================================================
# 1. Apply Ubuntu security updates
# ============================================================

RUN apt-get update && \
    apt-get install -y --only-upgrade \
        linux-libc-dev \
        openssl \
        libssl3t64 \
        apt \
        libapt-pkg6.0t64 \
        gnupg \
        gnupg-utils \
        gnupg2 \
        gpg \
        gpg-agent \
        gpgconf \
        gpgsm \
        gpgv \
        dirmngr \
        keyboxd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 2. Install GLiNER application
# ============================================================

WORKDIR /opt/vllm-gliner

COPY pyproject.toml README.md LICENSE ./
COPY forge/ forge/
COPY kernels/ kernels/
COPY models/ models/
COPY plugins/ plugins/
COPY poolers/ poolers/
COPY vllm_factory/ vllm_factory/

# ============================================================
# 3. Upgrade pip and vendored dependencies
# ============================================================

RUN python3 -m pip install \
    --no-cache-dir \
    --upgrade "pip==26.3"

# ============================================================
# 4. Install Python dependencies
# ============================================================

RUN pip install --no-cache-dir --no-deps . \
    && pip install --no-cache-dir \
       'gliner2==2.1.0' \
       sentencepiece \
       'dnspython==2.9.2'

# ============================================================
# 5. Remove unnecessary development packages
# ============================================================

RUN apt-get purge -y \
        linux-libc-dev \
        libc6-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# 6. Remove stale pip embedded SBOM
# ============================================================

RUN rm -f \
    /usr/local/lib/python3.12/dist-packages/pip/_vendor/bom.cdx.json
